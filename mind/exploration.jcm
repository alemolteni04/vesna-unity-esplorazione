mas exploration {
    agent explorer : explorer_v1.asl {
        ag-class: vesna.VesnaAgent
        beliefs: address(localhost)
                 port(8080)
        goals: start
        join: w
    }
    agent vesna_agent : vesna.asl {
        ag-class: vesna.VesnaAgent
        beliefs: address(localhost)
                 port(8081)
        goals: start
        join: w
    }
    workspace w {
    }
}
